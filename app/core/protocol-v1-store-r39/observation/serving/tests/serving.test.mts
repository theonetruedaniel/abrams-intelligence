import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';import {webcrypto} from 'node:crypto';import {createContext,runInContext} from 'node:vm';import {EventEmitter} from 'node:events';
import {createDocumentContract} from '../../../../../ui/pwa/host/document-contract.mts';import {createOwnedServingSession} from '../../../owner/serving-session.mts';import {createInjectedHttp} from './injected-http.mts';
const artifact=JSON.parse(readFileSync(new URL('../../../../../../.work/pwa/generated/document.json',import.meta.url),'utf8')),origin='http://127.0.0.1:45679',host='127.0.0.1:45679',delay=(ms=0)=>new Promise<void>(r=>setTimeout(r,ms)),bounded={timeout:4000};
class Element{textContent='';disabled=true;listeners=new Set<()=>void>();addEventListener(_n:string,fn:()=>void){this.listeners.add(fn);}removeEventListener(_n:string,fn:()=>void){this.listeners.delete(fn);}click(){if(!this.disabled)for(const fn of [...this.listeners])fn();}}
async function fixture(enabled=true){
 const contract=await createDocumentContract(artifact.inline),session=createOwnedServingSession({testOnly:true,host,documentContract:contract,enabled}),http=createInjectedHttp(session.component,origin),elements:any={},callbacks=new Set<()=>void>();
 let context:any=null,html='',response:Response|null=null;
 const mount=async()=>{
  response=await http.fetch(origin+'/');html=await response.text();assert.ok(html.startsWith(contract.prefix)&&html.endsWith(contract.suffix));
  for(const match of html.matchAll(/id="([^"]+)"/g))elements[match[1]]=new Element();elements['abrams-bootstrap'].textContent=html.slice(contract.prefix.length,html.length-contract.suffix.length);elements['abrams-startup'].textContent=artifact.inline;
  const document={documentElement:{getAttribute:()=> '3'},querySelectorAll(selector:string){if(selector==='meta[http-equiv="Content-Security-Policy"]')return [{getAttribute:()=>response!.headers.get('content-security-policy')}];const e=elements[selector.slice(1)];return e?[e]:[];},getElementById:(id:string)=>elements[id]};
  const window={addEventListener(_name:string,fn:()=>void){callbacks.add(fn);},removeEventListener(_name:string,fn:()=>void){callbacks.delete(fn);}};
  context=createContext({URL,crypto:webcrypto,TextEncoder,TextDecoder,Uint8Array,AbortController,performance,structuredClone,setTimeout,clearTimeout,document,window,location:{origin},fetch:http.fetch});runInContext(artifact.inline,context,{timeout:1000});return context.AbramsPwaReady;
 };
 return {session,http,contract,elements,callbacks,mount,response:()=>response,html:()=>html,click:(name:string)=>elements['abrams-page-'+name].click(),async cleanup(){for(const fn of [...callbacks])fn();await session.owner.close();await http.settle();assert.equal(http.active(),0);assert.equal(session.owner.snapshot().active,0);}};
}
test('null owner serves exact selfmount HTML with HTTP CSP and rejects all command routes',bounded,async()=>{
 const f=await fixture(false);try{assert.equal(await f.mount(),true);assert.equal(f.html(),artifact.html);assert.equal(f.response()!.headers.get('content-security-policy'),artifact.contract.csp);assert.equal(f.response()!.headers.get('cache-control'),'no-store');assert.equal(f.session.owner.snapshot().core,null);f.click('connect');assert.equal(f.http.records.length,1);for(const path of ['/events','/request']){const r=await f.http.exchange('POST',path,['Host',host,'Origin',origin],new Uint8Array());assert.equal(r.status,503);await r.text();}assert.equal(f.session.owner.snapshot().core,null);}finally{await f.cleanup();}
});
test('actual generated page uses serving adapter for Connect Start output Cancel Stop and refresh',bounded,async()=>{
 const f=await fixture();try{assert.equal(await f.mount(),true);assert.equal(f.session.owner.snapshot().total,1);f.click('connect');await delay(15);f.click('runStart');await delay(15);assert.equal(f.elements['abrams-page-outputs'].textContent,'pipe-output');f.click('runCancel');await delay(15);f.click('globalStop');await delay(15);f.click('refresh');await delay(20);assert.equal(f.elements['abrams-page-status'].textContent,'Ready');assert.equal(f.elements['abrams-page-cursor'].textContent,'3');assert.equal(f.session.owner.snapshot().total,9);const state=f.session.owner.snapshot().core;assert.equal(state.epoch,2);assert.equal(state.runs[0].state,'cancelled');assert.equal(state.accepted.filter((x:any)=>x.request.type==='start-mock-run').length,1);assert.equal(f.http.records.filter(x=>x.path==='/events').length,2);}finally{await f.cleanup();}
});
test('component exposes only exchange, not owner approval tick restart or close',bounded,async()=>{
 const f=await fixture();try{assert.deepEqual(Object.keys(f.session.component),['exchange']);assert.equal(f.session.owner.snapshot().core.approvals.length,2);}finally{await f.cleanup();}
});
test('raw duplicate Host cookies wrong Origin and unknown route cannot reach Core',bounded,async()=>{
 const f=await fixture();try{const before=JSON.stringify(f.session.owner.snapshot().core);for(const raw of [['Host',host,'Host',host],['Host',host,'Cookie','synthetic=1'],['Host','127.0.0.1:1'],['Host',host,'Origin','https://example.com']]){const r=await f.http.exchange('GET','/',raw,new Uint8Array());assert.equal(r.status,403);await r.text();}const bad=await f.http.exchange('GET','/not-owned',['Host',host],new Uint8Array());assert.equal(bad.status,400);await bad.text();assert.equal(JSON.stringify(f.session.owner.snapshot().core),before);}finally{await f.cleanup();}
});
test('request before generation registration and malformed generation are rejected',bounded,async()=>{
 const f=await fixture();try{for(const generation of ['0','2','01']){const r=await f.http.exchange('POST','/events',['Host',host,'Origin',origin,'X-Abrams-Transport-Binding','FAKE_TEST_ONLY_SERVING_V1','X-Abrams-Subscription-Generation',generation],new Uint8Array());assert.equal(r.status,403);await r.text();}assert.equal(f.session.owner.snapshot().core.runs.length,0);}finally{await f.cleanup();}
});
test('backpressure resumes exact event bytes and retires event exchange on local shutdown',bounded,async()=>{
 const f=await fixture();try{f.http.setBackpressure(true);await f.mount();f.click('connect');await delay(15);f.click('runStart');await delay(15);assert.equal(f.elements['abrams-page-outputs'].textContent,'pipe-output');f.click('shutdown');await delay(15);assert.equal(f.session.owner.snapshot().core.runs[0].state,'running');assert.equal(f.http.active(),0);assert.equal(f.http.records.find(x=>x.path==='/events').destroyed,true);}finally{await f.cleanup();}
});
test('Core unavailability during backpressured write prevents subsequent frame bytes',bounded,async()=>{
 const f=await fixture();try{await f.mount();f.click('connect');await delay(15);f.http.setBackpressure(true);let closed=false;f.http.onWrite(record=>{if(record.path==='/events'&&!closed){closed=true;f.session.owner.closeCoreForTest();}});f.click('runStart');await delay(30);assert.equal(closed,true);const stream=f.http.records.find(x=>x.path==='/events');assert.equal(stream.writes,1);assert.equal(stream.destroyed,true);assert.equal(f.session.owner.snapshot().availability.phase,'closed');await delay();assert.equal(stream.writes,1);}finally{await f.cleanup();}
});
test('finite twelve-request budget latches exhausted and does not admit a thirteenth',bounded,async()=>{
 const f=await fixture(false);try{for(let i=0;i<12;i++){const r=await f.http.fetch(origin+'/');assert.equal(r.status,200);await r.text();}await assert.rejects(f.http.fetch(origin+'/'));assert.equal(f.session.owner.snapshot().total,12);assert.equal(f.session.owner.snapshot().exhausted,true);}finally{await f.cleanup();}
});
test('owner close cancels active request-body wait without dispatch or response revival',bounded,async()=>{
 const f=await fixture();let release!:(value:any)=>void;const pending=new Promise(r=>release=r);const req:any=new EventEmitter();req.method='POST';req.url='/request';req.rawHeaders=['Host',host];let returns=0;req[Symbol.asyncIterator]=()=>({next:()=>pending,return:async()=>{returns++;return {done:true};}});const res:any=new EventEmitter();res.destroyed=false;res.destroy=()=>{res.destroyed=true;res.emit('close');};res.writeHead=()=>assert.fail('no response after abort');try{const task=f.session.component.exchange(req,res);assert.equal(f.session.owner.snapshot().active,1);assert.equal(await f.session.owner.close(),true);await task;release({done:true});await delay();assert.equal(returns,1);assert.equal(f.session.owner.snapshot().phase,'closed');assert.equal(res.destroyed,true);}finally{release({done:true});await f.cleanup();}
});
test('three exchange slots are reserved before reentrant response callbacks',bounded,async()=>{
 const f=await fixture(false);const held:any[]=[],jobs:Promise<any>[]=[],endCallbacks:Array<()=>void>=[];let launched=0;const launch=()=>{const req:any=new EventEmitter();req.method='GET';req.url='/';req.rawHeaders=['Host',host];req[Symbol.asyncIterator]=async function*(){};const res:any=new EventEmitter();res.destroyed=false;res.destroy=()=>{res.destroyed=true;res.emit('close');};res.writeHead=()=>{if(++launched<4)launch();};res.end=(_body:unknown,done:()=>void)=>{endCallbacks.push(done);};held.push(res);const job=f.session.component.exchange(req,res);jobs.push(job.catch(()=>{}));};try{launch();await delay(20);assert.equal(f.session.owner.snapshot().total,3);assert.equal(f.session.owner.snapshot().active,3);assert.equal(f.session.owner.snapshot().exhausted,true);assert.equal(endCallbacks.length,3);let closeSettled=false;const closing=f.session.owner.close().then(value=>{closeSettled=true;return value;});await delay();assert.equal(closeSettled,false);assert.equal(f.session.owner.snapshot().active,3);assert.equal(f.session.owner.snapshot().phase,'closing');for(const done of endCallbacks.splice(0))done();assert.equal(await closing,true);await Promise.all(jobs);assert.equal(f.session.owner.snapshot().active,0);assert.equal(f.session.owner.snapshot().phase,'closed');assert.equal(held.length,4);}finally{for(const done of endCallbacks.splice(0))done();await f.cleanup();}
});
