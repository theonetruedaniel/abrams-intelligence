import {readFileSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {canonical,initialState,evaluateControl,evaluateRequest} from './reference-core/shared/mock-core/state.mts';
import {normalizeFixtureConfiguration} from './reference-core/shared/mock-core/fixture-configuration.mts';
export const sha256=(v:string)=>createHash('sha256').update(v).digest('hex');
const check=(v:unknown)=>{if(!v)throw Error('O38 frozen registration differs');};
const sourceSha256='bc7a28ebf6f833c7f3be6af7782964f1c1009f4319e8d0df587c2f116d9b9e51';
const bytes=readFileSync(new URL('./frozen-fixtures/core-v1-draft.json',import.meta.url));
check(createHash('sha256').update(bytes).digest('hex')===sourceSha256);
const cases=JSON.parse(bytes.toString('utf8')).cases.filter((x:any)=>x.id==='O38');check(cases.length===1);
const trace=cases[0];check(trace.steps.map((s:any)=>s.op).join(',')==='set-harness-fixture,approve,request,tick,tick,request');
const [fixture,approve,start,ticks,rejected,stop]=trace.steps;
check(fixture.outputs.length===127&&fixture.outputs.every((x:any)=>x==='capacity')&&ticks.runId==='A'&&ticks.count===126&&rejected.runId==='A'&&rejected.count===1&&canonical(rejected.expect)===canonical({code:'fixture_limit',stateUnchanged:true}));
const inputConfiguration={version:1,H:{outputs:fixture.outputs}},configuration=normalizeFixtureConfiguration(inputConfiguration);
const a=approve.approval,approval={approvalId:a.approvalId,revision:a.approvalRevision,runId:a.runId,fixtureId:a.fixtureId,epoch:a.epoch};
const initial=initialState('synthetic-session',configuration),states=[initial];
check(initial.epoch===trace.initial.epoch&&canonical(initial.grants)===canonical(trace.initial.grants)&&canonical(initial.journal)===canonical(trace.initial.journal)&&canonical(initial.approvals)===canonical(trace.initial.approvals));
states.push(evaluateControl(initial,{type:'approve',approval}).state);
const started=evaluateRequest(states.at(-1),start.message);states.push(started.state);
check(canonical(started.reply)===canonical({v:1,type:start.message.type,requestId:start.message.requestId,...start.expect}));
for(let n=0;n<126;n++)states.push(evaluateControl(states.at(-1),{type:'tick',runId:'A'}).state);
const prefix=states.at(-1);let denied=false;
try{evaluateControl(prefix,{type:'tick',runId:'A'});}catch(e:any){check(e.message==='fixture_limit');denied=true;}check(denied);
const stopped=evaluateRequest(prefix,stop.message),final=stopped.state;
check(canonical(stopped.reply)===canonical({v:1,type:stop.message.type,requestId:stop.message.requestId,...stop.expect}));
check(prefix.commitSeq===128&&prefix.journal.length===127&&prefix.runs.length===1&&prefix.runs[0].state==='running'&&prefix.runs[0].terminalReserved===1);
check(final.commitSeq===129&&final.epoch===2&&final.journal.length===128&&final.runs[0].state==='stopped'&&final.runs[0].terminalReserved===0);
check(canonical({epoch:final.epoch,journal:final.journal.map((j:any)=>j.event),runs:Object.fromEntries(final.runs.map((r:any)=>[r.runId,r.state]))})===canonical(trace.final));
const freeze=(v:any):any=>{if(v&&typeof v==='object'){for(const x of Object.values(v))freeze(x);Object.freeze(v);}return v;};
export const O38=freeze({sourceSha256,trace,inputConfiguration,configuration,configurationSha256:sha256(canonical(configuration)),approval,initial,states,prefix,final,startRequest:start.message,startReply:started.reply,stopRequest:stop.message,stopReply:stopped.reply});
