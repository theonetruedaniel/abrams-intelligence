import test from 'node:test';
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {createRendererController,type RendererView,type RendererHandlers,type RendererSnapshot} from '../renderer/controller.mts';
import {createShellCoreAdapter,type ShellCorePort} from '../renderer/shell-core-adapter.mts';
import {createOwnedReferenceCoreTransport} from '../../../../../core/protocol-v1-shell-r3/owner/inputs/owned-reference-core-transport.mts';
const turn=()=>new Promise<void>(r=>setTimeout(r,0));
const intent=(runId='A')=>({runId,fixtureId:'H',approvalId:'approval_'+runId,approvalRevision:1});
const owned=()=>createOwnedReferenceCoreTransport({testOnly:true,sessionId:'synthetic-renderer-controller',fixtureConfiguration:{version:1,H:{outputs:['actual-output']}}});
const approve=(o:ReturnType<typeof owned>,id='A')=>o.owner.approve({approvalId:'approval_'+id,revision:1,runId:id,fixtureId:'H',epoch:o.owner.inspectState().epoch});
function view(){let handlers!:RendererHandlers;const frames:RendererSnapshot[]=[];let removals=0;const v:RendererView={bind(h){handlers=h;return()=>{removals++;};},render(s){frames.push(s);}};return {v,frames,get h(){return handlers;},get removals(){return removals;},get last(){return frames.at(-1)!;}};}
function delayed<T>(){let resolve!:(v:T)=>void,reject!:(e:unknown)=>void;const promise=new Promise<T>((a,b)=>{resolve=a;reject=b;});return {promise,resolve,reject};}
function gated(o:ReturnType<typeof owned>){let hold=false;const reply=delayed<Uint8Array>(),release=delayed<void>();let holdRelease=false;let receive:((g:number,b:Uint8Array)=>boolean)|undefined;let end:(()=>void)|undefined;let requests=0;const p:ShellCorePort={protocol:1,binding:o.port.binding,async openEvents(g,r,e){receive=r;end=e;const close=await o.port.openEvents(g,r,e);return async()=>{if(holdRelease)await release.promise;await close();};},async request(b,g){requests++;const result=await o.port.request(b,g);if(hold)await reply.promise;return result;}};return {p,reply,release,get receive(){return receive!;},get end(){return end!;},get requests(){return requests;},holdReply(){hold=true;},holdRelease(){holdRelease=true;}};}
test('default renderer is honestly disconnected and commands cannot connect it',async()=>{const v=view(),c=createRendererController(v.v);assert.equal(v.last.core.connected,false);assert.equal(v.last.core.unconnected,true);assert.equal(await v.h.reconnect(),false);assert.equal(await v.h.health(),false);assert.equal(v.last.core.view.cursor,0);c.unmount();});
test('view controls reach actual reference Core with owner-issued approval only',async()=>{const o=owned(),v=view(),c=createRendererController(v.v,o.port);assert.equal(await v.h.reconnect(),true);approve(o);approve(o,'B');assert.equal(await v.h.start(intent()),true);assert.equal(await v.h.start(intent('B')),true);assert.equal(await v.h.health(),true);assert.equal(await v.h.cancel('A'),true);assert.equal(await v.h.stop(),true);await turn();assert.deepEqual(v.last.core.view.runs,{A:'cancelled',B:'stopped'});assert.equal(o.owner.inspectState().epoch,2);c.unmount();});
test('start cannot manufacture approval or a visible run',async()=>{const o=owned(),v=view(),c=createRendererController(v.v,o.port);await v.h.reconnect();assert.equal(await v.h.start(intent()),false);await turn();assert.equal(o.owner.inspectState().runs.length,0);assert.equal(v.last.core.view.cursor,0);assert.equal(v.last.lastCommand?.ok,false);c.unmount();});
test('owner events update view without any subsequent renderer action',async()=>{const o=owned(),v=view(),c=createRendererController(v.v,o.port);await v.h.reconnect();approve(o);await v.h.start(intent());o.owner.tick('A');await turn();assert.equal(v.last.core.view.cursor,2);assert.equal(v.last.core.view.records.at(-1)?.data.text,'actual-output');assert.equal(v.last.core.view.runs.A,'running');c.unmount();});
test('external end updates disconnected state without invented terminal run',async()=>{const o=owned(),v=view(),c=createRendererController(v.v,o.port);await v.h.reconnect();approve(o);await v.h.start(intent());o.owner.revoke('cancel');await turn();assert.equal(v.last.core.connected,false);assert.equal(v.last.core.cleanupPending,false);assert.equal(o.owner.inspectState().runs[0].state,'running');c.unmount();});
test('local disconnect never means global Stop, explicit reconnect replays',async()=>{const o=owned(),v=view(),c=createRendererController(v.v,o.port);await v.h.reconnect();approve(o);await v.h.start(intent());v.h.disconnect();await turn();assert.equal(o.owner.inspectState().runs[0].state,'running');assert.equal(o.owner.inspectState().epoch,1);assert.equal(await v.h.reconnect(),true);assert.equal(v.last.core.view.runs.A,'running');c.unmount();});
test('pending and repeated input are rejected without duplicate dispatch',async()=>{const o=owned(),g=gated(o),v=view(),c=createRendererController(v.v,g.p);await v.h.reconnect();g.holdReply();const first=v.h.health();await turn();const n=g.requests;assert.equal(v.last.pending,'health');assert.equal(await v.h.health(),false);assert.equal(await v.h.stop(),false);assert.equal(g.requests,n);g.reply.resolve(new Uint8Array());assert.equal(await first,true);c.unmount();});
test('late reply after disconnect cannot repaint success or reopen session',async()=>{const o=owned(),g=gated(o),v=view(),c=createRendererController(v.v,g.p);await v.h.reconnect();g.holdReply();const p=v.h.health();v.h.disconnect();g.reply.resolve(new Uint8Array());assert.equal(await p,false);await turn();assert.equal(v.last.core.connected,false);assert.equal(v.last.pending,null);assert.equal(v.last.lastCommand,null);c.unmount();});
test('cleanup completion produces final render after deferred release',async()=>{const o=owned(),g=gated(o),v=view(),c=createRendererController(v.v,g.p);await v.h.reconnect();g.holdRelease();v.h.disconnect();await turn();assert.equal(v.last.core.cleanupPending,true);assert.equal(await v.h.reconnect(),false);g.release.resolve();await turn();assert.equal(v.last.core.cleanupPending,false);assert.equal(await v.h.reconnect(),true);c.unmount();});
test('release rejection remains cleanup pending without automatic replacement',async()=>{const o=owned(),g=gated(o),v=view(),c=createRendererController(v.v,g.p);await v.h.reconnect();g.holdRelease();v.h.disconnect();g.release.reject(Error('release uncertainty'));await turn();assert.equal(v.last.core.cleanupPending,true);assert.equal(await v.h.reconnect(),false);assert.equal(o.owner.inspectTransport().generation,1);c.unmount();});
test('stale generation callbacks cannot add a run after explicit reconnect',async()=>{const o=owned(),g=gated(o),v=view(),c=createRendererController(v.v,g.p);await v.h.reconnect();const stale=g.receive,oldEnd=g.end;v.h.disconnect();await turn();await v.h.reconnect();const before=v.last.core.view.cursor;assert.equal(stale(1,new TextEncoder().encode('{}')),false);oldEnd();await turn();assert.equal(v.last.core.connected,true);assert.equal(v.last.core.view.cursor,before);c.unmount();});
test('malformed event retires session and renders error/disconnect without retry',async()=>{const o=owned(),g=gated(o),v=view(),c=createRendererController(v.v,g.p);await v.h.reconnect();const n=g.requests;assert.equal(g.receive(1,new TextEncoder().encode('{}')),false);await turn();assert.equal(v.last.core.connected,false);assert.equal(g.requests,n);c.unmount();});
test('render-triggered handlers cannot recursively dispatch',async()=>{const o=owned(),v=view();let reentry:Promise<boolean>|undefined;const render=v.v.render;v.v.render=s=>{render(s);if(s.core.connected)reentry=v.h.stop();};const c=createRendererController(v.v,o.port);await v.h.reconnect();await turn();assert.equal(await reentry,false);assert.equal(o.owner.inspectState().epoch,1);c.unmount();});
test('bind-triggered handlers stay inert until binding succeeds',async()=>{const o=owned(),v=view();let p:Promise<boolean>|undefined;const bind=v.v.bind;v.v.bind=h=>{p=h.reconnect();return bind(h);};const c=createRendererController(v.v,o.port);assert.equal(await p,false);assert.equal(o.owner.inspectTransport().generation,0);c.unmount();});
test('bind failure leaves retained handlers inert',async()=>{const o=owned();let h!:RendererHandlers;assert.throws(()=>createRendererController({bind(x){h=x;throw Error('bind');},render(){}},o.port));assert.equal(await h.reconnect(),false);assert.equal(o.owner.inspectTransport().generation,0);});
test('render failure unmounts locally without Stop or unhandled rejection',async()=>{const o=owned(),v=view();v.v.render=s=>{if(s.core.connected)throw Error('render');};const c=createRendererController(v.v,o.port);await v.h.reconnect();await turn();assert.equal(c.snapshot().mounted,false);assert.equal(v.removals,1);assert.equal(o.owner.inspectState().epoch,1);});
test('unbind failure is reported and retry cannot reactivate retained handlers',async()=>{const o=owned(),v=view();let n=0;v.v.bind=h=>{const original=view();original.v.bind(h);return()=>{if(++n===1)throw Error('unbind');};};const c=createRendererController(v.v,o.port);assert.equal(c.unmount(),false);assert.equal(c.snapshot().unbindFailed,true);assert.equal(c.unmount(),true);assert.equal(c.snapshot().mounted,false);});
test('unmount retires transport, ignores queued renders and stale controls',async()=>{const o=owned(),v=view(),c=createRendererController(v.v,o.port);await v.h.reconnect();approve(o);await v.h.start(intent());o.owner.tick('A');const n=v.frames.length;assert.equal(c.unmount(),true);assert.equal(c.unmount(),true);await turn();assert.equal(v.frames.length,n);assert.equal(await v.h.stop(),false);assert.equal(await v.h.reconnect(),false);assert.equal(o.owner.inspectState().epoch,1);assert.equal(o.owner.inspectTransport().deliveryActive,false);assert.equal(v.removals,1);});
test('snapshots cannot mutate projection and observer exceptions cannot own state',async()=>{const o=owned(),v=view(),c=createRendererController(v.v,o.port);await v.h.reconnect();assert.throws(()=>{(v.last.core.view.runs as any).invented='succeeded';});assert.deepEqual(c.snapshot().core.view.runs,{});c.unmount();const second=owned(),a=createShellCoreAdapter(second.port,()=>{throw Error('observer');});assert.equal(await a.reconnect(),true);await turn();assert.equal(a.snapshot().connected,true);a.shutdown();await turn();assert.equal(a.snapshot().cleanupPending,false);});
test('renderer import closure excludes owner, Core transitions, stores and native/network APIs',()=>{const paths=['controller.mts','shell-core-adapter.mts','projection.mts','canonical.mts'];const allowed=new Set(paths.map(x=>'renderer/'+x).concat(['inputs/shared/contracts/protocol.mts','inputs/strict-reply.mts']));const seen=new Set<string>();const visit=(p:string)=>{if(seen.has(p))return;seen.add(p);assert.ok(allowed.has(p),'unadmitted renderer import '+p);const src=readFileSync(new URL('../'+p,import.meta.url),'utf8');assert.doesNotMatch(src,/\b(?:import\s*\(|require\s*\(|fetch\s*\(|XMLHttpRequest|WebSocket|process\.|Deno\.|Bun\.|eval\s*\(|Function\s*\(|setInterval\s*\(|setTimeout\s*\()/);for(const m of src.matchAll(/(?:from\s*|import\s*)['"]([^'"]+)['"]/g)){assert.ok(m[1].startsWith('.'));const u=new URL(m[1],new URL('../'+p,import.meta.url));const base=new URL('../',import.meta.url);assert.ok(u.href.startsWith(base.href));visit(decodeURIComponent(u.href.slice(base.href.length)));}};visit('renderer/controller.mts');assert.equal(seen.size,6);const original=readFileSync(new URL('../inputs/shared/mock-core/state.mts',import.meta.url),'utf8').split(/\r?\n/)[1];assert.equal(readFileSync(new URL('../renderer/canonical.mts',import.meta.url),'utf8').trim(),original);});
test('render-triggered disconnect cannot create a render notification loop',async()=>{const v=view();const render=v.v.render;let n=0;v.v.render=s=>{render(s);if(++n<=3)v.h.disconnect();};const c=createRendererController(v.v);await turn();assert.equal(v.frames.length,1);c.unmount();});
test('observer idempotent disconnect cannot create notifications during pending cleanup',async()=>{const o=owned(),g=gated(o);let pendingNotifications=0;const a=createShellCoreAdapter(g.p,()=>{if(a.snapshot().cleanupPending){pendingNotifications++;if(pendingNotifications<=3)a.disconnect();}});await a.reconnect();g.holdRelease();a.disconnect();await turn();assert.equal(pendingNotifications,1);g.release.resolve();await turn();a.shutdown();});
test('intent getter disconnects before start dispatch and cannot forge success',async()=>{const o=owned(),v=view(),c=createRendererController(v.v,o.port);await v.h.reconnect();approve(o);const i=intent();Object.defineProperty(i,'approvalId',{enumerable:true,get(){v.h.disconnect();return 'approval_A';}});assert.equal(await v.h.start(i),false);await turn();assert.equal(o.owner.inspectState().runs.length,0);assert.equal(v.last.lastCommand,null);c.unmount();});
test('intent ownKeys unmount leaves nested controls inert before dispatch',async()=>{const o=owned(),v=view(),c=createRendererController(v.v,o.port);await v.h.reconnect();approve(o);let nested:Promise<boolean>|undefined;const i=new Proxy(intent(),{ownKeys(target){c.unmount();nested=v.h.start(intent('B'));return Reflect.ownKeys(target);}});assert.equal(await v.h.start(i),false);assert.equal(await nested,false);assert.equal(o.owner.inspectState().runs.length,0);});
test('throwing view callback getters fail construction without acquisition',()=>{for(const key of ['bind','render']){const o=owned(),v=view();Object.defineProperty(v.v,key,{get(){throw Error('view getter');}});assert.throws(()=>createRendererController(v.v,o.port));assert.equal(o.owner.inspectTransport().generation,0);}});
test('snapshot binding getter unmount cannot deliver a post-unmount frame',async()=>{const o=owned(),v=view();let c:ReturnType<typeof createRendererController>|undefined,armed=false;const p:ShellCorePort={protocol:1,get binding(){if(armed){armed=false;c!.unmount();}return o.port.binding;},openEvents:(...args)=>o.port.openEvents(...args),request:(...args)=>o.port.request(...args)};c=createRendererController(v.v,p);await v.h.reconnect();approve(o);await v.h.start(intent());const n=v.frames.length;o.owner.tick('A');armed=true;await turn();assert.equal(v.frames.length,n);assert.equal(c.snapshot().mounted,false);});
test('public snapshot reflects unmount caused by injected binding getter',async()=>{const o=owned(),v=view();let c:ReturnType<typeof createRendererController>|undefined,armed=false;const p:ShellCorePort={protocol:1,get binding(){if(armed){armed=false;c!.unmount();}return o.port.binding;},openEvents:(...args)=>o.port.openEvents(...args),request:(...args)=>o.port.request(...args)};c=createRendererController(v.v,p);await v.h.reconnect();armed=true;assert.equal(c.snapshot().mounted,false);});
test('late acquisition release renders settled cleanup without another UI action',async()=>{const o=owned(),v=view(),gate=delayed<void>();const p:ShellCorePort={protocol:1,binding:o.port.binding,async openEvents(...args){const release=await o.port.openEvents(...args);await gate.promise;return release;},request:(...args)=>o.port.request(...args)};const c=createRendererController(v.v,p);const connecting=v.h.reconnect();v.h.disconnect();await turn();assert.equal(v.last.core.cleanupPending,true);gate.resolve();assert.equal(await connecting,false);await turn();assert.equal(v.last.core.cleanupPending,false);assert.equal(o.owner.inspectTransport().deliveryActive,false);c.unmount();});
test('acknowledgements do not manufacture started or terminal events',async()=>{const o=owned(),v=view();let drop=false;const p:ShellCorePort={protocol:1,binding:o.port.binding,openEvents(g,r,e){return o.port.openEvents(g,(gen,b)=>drop?true:r(gen,b),e);},request:(...args)=>o.port.request(...args)};const c=createRendererController(v.v,p);await v.h.reconnect();approve(o);drop=true;assert.equal(await v.h.start(intent()),true);await turn();assert.equal(Object.keys(v.last.core.view.runs).length,0);drop=false;v.h.disconnect();await turn();await v.h.reconnect();assert.equal(v.last.core.view.runs.A,'running');drop=true;assert.equal(await v.h.cancel('A'),true);await turn();assert.equal(v.last.core.view.runs.A,'running');assert.equal(o.owner.inspectState().runs[0].state,'cancelled');c.unmount();});
test('public snapshot cannot reenter Stop through a binding getter',async()=>{const o=owned(),v=view();let armed=false,nested:Promise<boolean>|undefined;const p:ShellCorePort={protocol:1,get binding(){if(armed){armed=false;nested=v.h.stop();}return o.port.binding;},openEvents:(...args)=>o.port.openEvents(...args),request:(...args)=>o.port.request(...args)};const c=createRendererController(v.v,p);await v.h.reconnect();armed=true;c.snapshot();assert.equal(await nested,false);assert.equal(o.owner.inspectState().epoch,1);c.unmount();});
test('successor observer receives settled reconnect busy=false',async()=>{const o=owned();const frames:any[]=[];const a=createShellCoreAdapter(o.port,()=>frames.push(a.snapshot()));assert.equal(await a.reconnect(),true);await turn();assert.equal(frames.at(-1).connected,true);assert.equal(frames.at(-1).busy,false);a.shutdown();await turn();assert.equal(frames.at(-1).cleanupPending,false);});
test('Projection delta is import-only and adapter regression has only declared recovery assertion delta',()=>{const read=(p:string)=>readFileSync(new URL('../'+p,import.meta.url),'utf8');const original=read('inputs/shared/client/projection.mts').replace("'../contracts/protocol.mts'","'../inputs/shared/contracts/protocol.mts'").replace("'../mock-core/state.mts'","'./canonical.mts'");assert.equal(read('renderer/projection.mts'),original);const strip=(s:string)=>s.replace(/^import .*;\r?\n/gm,'');const oldAssertion=" assert.equal(await f.adapter.health(),true);assert.equal(f.adapter.snapshot().view.degraded,true);assert.equal(await f.adapter.globalStop(),false);";const newAssertion=" assert.equal(await f.adapter.health(),true);assert.equal(f.adapter.snapshot().view.degraded,false);assert.deepEqual(f.adapter.snapshot().view.runs,{A:'running'});assert.deepEqual(f.requests.slice(-2).map(q=>q.type),['health','reconnect']);";const baseline=strip(read('inputs/shell-core-adapter.test.mts'));assert.equal(baseline.split(oldAssertion).length,2);assert.equal(strip(read('tests/shell-core-adapter.test.mts')),baseline.replace(oldAssertion,newAssertion));});
