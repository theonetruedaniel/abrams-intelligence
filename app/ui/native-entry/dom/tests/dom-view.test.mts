import test from 'node:test';
import assert from 'node:assert/strict';
import {existsSync,readFileSync} from 'node:fs';
import {FakeDocument} from './fake-dom.mts';
import {createOwnedReferenceCoreTransport} from '../../../../core/protocol-v1-shell-r3/owner/inputs/owned-reference-core-transport.mts';
import type {ShellCorePort} from '../base/renderer/shell-core-adapter.mts';
const source=new URL('../renderer/dom-view.mts',import.meta.url);
const turn=()=>new Promise<void>(r=>setTimeout(r,0));
const load=async()=>await import('../renderer/dom-view.mts');
const intent=(runId='A')=>({runId,fixtureId:'H',approvalId:'approval_'+runId,approvalRevision:1});
const owned=()=>createOwnedReferenceCoreTransport({testOnly:true,sessionId:'synthetic-dom',fixtureConfiguration:{version:1,H:{outputs:['<img src=x onerror=evil()>']}}});
const approve=(o:ReturnType<typeof owned>,id='A')=>o.owner.approve({approvalId:'approval_'+id,revision:1,runId:id,fixtureId:'H',epoch:o.owner.inspectState().epoch});
async function setup(port:ShellCorePort|null=null){const api=await load(),d=new FakeDocument(),host=d.host(),sibling=d.createElement('span');sibling.textContent='host content';host.appendChild(sibling);const m=api.mountDomRenderer({document:d as unknown as Document,container:host as unknown as HTMLElement},port);return {d,host,sibling,m};}
async function connect(s:Awaited<ReturnType<typeof setup>>){s.d.button('Reconnect explicitly').click();await turn();assert.equal(s.m.snapshot().core.connected,true);}
test('concrete DOM binding source exists',()=>assert.ok(existsSync(source),'DOM-facing module must exist'));
test('default disconnected mount preserves host content and has no automatic connection',async()=>{const s=await setup();assert.equal(s.m.snapshot().core.unconnected,true);assert.match(s.host.textContent,/No consumer port/);assert.equal(s.d.button('Reconnect explicitly').disabled,true);assert.equal(s.host.children[0],s.sibling);s.m.unmount();assert.deepEqual(s.host.children,[s.sibling]);});
test('all visible buttons are explicit non-submit controls and status is labelled live text',async()=>{const s=await setup();for(const b of s.d.elements.filter(x=>x.tagName==='button'))assert.equal(b.type,'button');const status=s.d.paragraph('Connection:');assert.equal(status.attrs.get('role'),'status');assert.equal(status.attrs.get('aria-live'),'polite');assert.match(s.host.textContent,/Start selection: none/);s.m.unmount();});
test('external approval selection reaches actual Core without view approval authority',async()=>{const o=owned(),s=await setup(o.port);await connect(s);assert.equal(s.d.button('Start selected run').disabled,true);approve(o);assert.equal(s.m.setStartIntent(intent()),true);s.d.button('Start selected run').click();await turn();assert.equal(o.owner.inspectState().runs[0].state,'running');assert.match(s.host.textContent,/A: running/);s.m.unmount();});
test('unapproved selection cannot create a run or synthetic successful state',async()=>{const o=owned(),s=await setup(o.port);await connect(s);s.m.setStartIntent(intent());s.d.button('Start selected run').click();await turn();assert.equal(o.owner.inspectState().runs.length,0);assert.match(s.host.textContent,/start: rejected/);assert.doesNotMatch(s.host.textContent,/A: running/);s.m.unmount();});
test('run cancellation requires explicit authoritative running selection',async()=>{const o=owned(),s=await setup(o.port);await connect(s);assert.equal(s.m.selectCancelRun('unknown'),false);approve(o);s.m.setStartIntent(intent());s.d.button('Start selected run').click();await turn();assert.equal(s.d.button('Cancel selected run').disabled,true);assert.equal(s.m.selectCancelRun('A'),true);s.d.button('Cancel selected run').click();await turn();assert.equal(o.owner.inspectState().runs[0].state,'cancelled');assert.equal(s.d.button('Cancel selected run').disabled,true);s.m.unmount();});
test('owner events update visible safe text without later clicks or parsed payload markup',async()=>{const o=owned(),s=await setup(o.port);await connect(s);approve(o);s.m.setStartIntent(intent());s.d.button('Start selected run').click();await turn();o.owner.tick('A');await turn();assert.match(s.host.textContent,/<img src=x onerror=evil\(\)>/);assert.equal(s.d.elements.some(x=>x.tagName==='img'),false);assert.match(s.host.textContent,/Event 2 A output/);s.m.unmount();});
test('same-turn repeated clicks dispatch only one command',async()=>{const o=owned(),s=await setup(o.port);await connect(s);approve(o);s.m.setStartIntent(intent());const b=s.d.button('Start selected run');const clicks=b.retained();clicks[0]();clicks[0]();await turn();assert.equal(o.owner.inspectState().runs.length,1);assert.equal(s.m.snapshot().lastCommand?.ok,true);s.m.unmount();});
test('local disconnect and local unmount never issue global Stop',async()=>{const o=owned(),s=await setup(o.port);await connect(s);approve(o);s.m.setStartIntent(intent());s.d.button('Start selected run').click();await turn();s.d.button('Disconnect locally').click();await turn();assert.equal(o.owner.inspectState().epoch,1);assert.equal(o.owner.inspectState().runs[0].state,'running');s.m.unmount();assert.equal(o.owner.inspectState().epoch,1);});
test('global Stop remains an explicit separate action',async()=>{const o=owned(),s=await setup(o.port);await connect(s);s.d.button('Stop all runs globally').click();await turn();assert.equal(o.owner.inspectState().epoch,2);s.m.unmount();});
test('retained click callbacks and host setters stay inert after teardown',async()=>{const o=owned(),s=await setup(o.port);await connect(s);const retained=s.d.button('Stop all runs globally').retained();s.m.unmount();const writes=s.d.totalWrites();retained[0]();assert.equal(s.m.setStartIntent(intent()),false);assert.equal(s.m.selectCancelRun('A'),false);await turn();assert.equal(s.d.totalWrites(),writes);assert.equal(o.owner.inspectState().epoch,1);});
test('DOM text setter reentry cannot dispatch Stop during rendering',async()=>{const o=owned(),s=await setup(o.port);await connect(s);const stop=s.d.button('Stop all runs globally').retained()[0];s.d.paragraph('Connection:').hook=op=>{if(op==='text')stop();};s.m.setStartIntent(intent());await turn();assert.equal(o.owner.inspectState().epoch,1);s.m.unmount();});
test('unmount during DOM setter permits no subsequent DOM write operations',async()=>{const o=owned(),s=await setup(o.port);await connect(s);let armed=true,after=0;s.d.hook=(_e,op)=>{if(!armed&&['text','value','disabled','attribute','append','type'].includes(op))after++;if(armed&&op==='text'){armed=false;s.m.unmount();}};s.m.setStartIntent(intent());assert.equal(after,0);assert.equal(s.m.snapshot().mounted,false);assert.deepEqual(s.host.children,[s.sibling]);});
test('host intent getters cannot reenter commands or overwrite a newer selection',async()=>{const o=owned(),s=await setup(o.port);await connect(s);const stop=s.d.button('Stop all runs globally').retained()[0];const i=intent();Object.defineProperty(i,'runId',{get(){stop();s.m.setStartIntent(intent('B'));return 'A';}});assert.equal(s.m.setStartIntent(i),false);assert.equal(o.owner.inspectState().epoch,1);assert.match(s.host.textContent,/Start selection: none/);s.m.unmount();});
test('partial bind failure removes owned nodes and previously registered listeners',async()=>{const api=await load(),d=new FakeDocument(),host=d.host();let n=0;d.hook=(_e,op)=>{if(op==='add-listener'&&++n===3)throw Error('partial bind');};assert.throws(()=>api.mountDomRenderer({document:d as unknown as Document,container:host as unknown as HTMLElement}));assert.equal(host.children.length,0);assert.equal(d.elements.reduce((n,e)=>n+[...e.listeners.values()].reduce((a,b)=>a+b.size,0),0),0);});
test('partial unbind failure attempts all releases and explicit retry completes cleanup',async()=>{const s=await setup();const first=s.d.button('Reconnect explicitly');let fail=true;first.hook=op=>{if(op==='remove-listener'&&fail){fail=false;throw Error('remove failed');}};assert.equal(s.m.unmount(),false);assert.equal(s.m.snapshot().unbindFailed,true);assert.deepEqual(s.host.children,[s.sibling]);assert.equal(s.m.unmount(),true);assert.equal(s.d.elements.reduce((n,e)=>n+[...e.listeners.values()].reduce((a,b)=>a+b.size,0),0),0);});
test('cleanup uncertainty blocks replacement and stays visible without polling or retry',async()=>{const o=owned();const p:ShellCorePort={...o.port,async openEvents(...args){const close=await o.port.openEvents(...args);return async()=>{await close();throw Error('unknown release');};}};const s=await setup(p);await connect(s);s.d.button('Disconnect locally').click();await turn();assert.match(s.host.textContent,/cleanup pending or unknown/);assert.equal(s.d.button('Reconnect explicitly').disabled,true);assert.equal(o.owner.inspectTransport().generation,1);s.m.unmount();});
test('acknowledgement text remains distinct from authoritative missing events',async()=>{const o=owned();let drop=false;const p:ShellCorePort={...o.port,openEvents(g,r,e){return o.port.openEvents(g,(gen,b)=>drop?true:r(gen,b),e);}};const s=await setup(p);await connect(s);approve(o);s.m.setStartIntent(intent());drop=true;s.d.button('Start selected run').click();await turn();assert.match(s.host.textContent,/start: acknowledged/);assert.match(s.host.textContent,/Runs from authoritative events: none/);s.m.unmount();});
test('DOM renderer import closure contains frozen controller only, excludes owner and unsafe sinks',()=>{const allowed=new Set(['renderer/dom-view.mts','base/renderer/controller.mts','base/renderer/shell-core-adapter.mts','base/renderer/projection.mts','base/renderer/canonical.mts','base/inputs/shared/contracts/protocol.mts','base/inputs/strict-reply.mts']);const seen=new Set<string>();const visit=(p:string)=>{assert.ok(allowed.has(p),p);if(seen.has(p))return;seen.add(p);const src=readFileSync(new URL('../'+p,import.meta.url),'utf8');assert.doesNotMatch(src,/\b(?:innerHTML|outerHTML|insertAdjacentHTML|document\.querySelector|fetch|WebSocket|XMLHttpRequest|eval|setInterval|setTimeout|require)\b|import\s*\(|process\./);for(const m of src.matchAll(/from\s*['"]([^'"]+)['"]/g)){const u=new URL(m[1],new URL('../'+p,import.meta.url));const base=new URL('../',import.meta.url);assert.ok(u.href.startsWith(base.href));visit(decodeURIComponent(u.href.slice(base.href.length)));}};visit('renderer/dom-view.mts');assert.equal(seen.size,7);});

test('visible cancel input selects a running run and invalid input clears old selection',async()=>{const o=owned(),s=await setup(o.port);await connect(s);approve(o);s.m.setStartIntent(intent());s.d.button('Start selected run').click();await turn();const input=s.d.elements.find(x=>x.tagName==='input')!;input.value='A';for(const f of input.listeners.get('change')??[])f();assert.equal(s.d.button('Cancel selected run').disabled,false);input.value='unknown';for(const f of input.listeners.get('change')??[])f();assert.equal(s.d.button('Cancel selected run').disabled,true);s.m.unmount();});
test('input value getter reentry cannot dispatch Stop or retain selection after unmount',async()=>{const o=owned(),s=await setup(o.port);await connect(s);const input=s.d.elements.find(x=>x.tagName==='input')!,stop=s.d.button('Stop all runs globally').retained()[0];input.hook=op=>{if(op==='read-value'){stop();s.m.unmount();}};for(const f of input.listeners.get('change')??[])f();await turn();assert.equal(o.owner.inspectState().epoch,1);assert.equal(s.m.snapshot().mounted,false);});
test('partial registration that adds before throwing still rolls back',async()=>{const api=await load(),d=new FakeDocument(),host=d.host();const original=d.createElement.bind(d);d.createElement=(tag:string)=>{const n=original(tag),add=n.addEventListener.bind(n);n.addEventListener=(t,f)=>{add(t,f);if(t==='click')throw Error('added then threw');};return n;};assert.throws(()=>api.mountDomRenderer({document:d as unknown as Document,container:host as unknown as HTMLElement}));assert.equal(host.children.length,0);assert.equal(d.elements.reduce((n,e)=>n+[...e.listeners.values()].reduce((a,b)=>a+b.size,0),0),0);});
test('registration reentry and release reentry cannot dispatch retained clicks',async()=>{const api=await load(),d=new FakeDocument(),host=d.host(),o=owned();d.hook=(e,op)=>{if(op==='add-listener'||op==='remove-listener')for(const f of e.retained())f();};const m=api.mountDomRenderer({document:d as unknown as Document,container:host as unknown as HTMLElement},o.port);assert.equal(o.owner.inspectTransport().generation,0);m.unmount();assert.equal(o.owner.inspectState().epoch,1);});
test('throwing display setter causes local unmount with no Stop',async()=>{const o=owned(),s=await setup(o.port);await connect(s);s.d.paragraph('Connection:').hook=op=>{if(op==='text')throw Error('display setter');};assert.equal(s.m.setStartIntent(intent()),false);assert.equal(s.m.snapshot().mounted,false);assert.equal(o.owner.inspectState().epoch,1);assert.deepEqual(s.host.children,[s.sibling]);});
test('pending request disables visible actions and retained repeats cannot dispatch',async()=>{const o=owned();let hold=false,release!:()=>void,requests=0;const gate=new Promise<void>(r=>release=r);const p:ShellCorePort={...o.port,async request(...args){requests++;const r=await o.port.request(...args);if(hold)await gate;return r;}};const s=await setup(p);await connect(s);hold=true;s.d.button('Check health').click();await turn();assert.match(s.host.textContent,/pending health/);assert.equal(s.d.button('Stop all runs globally').disabled,true);const n=requests;s.d.button('Stop all runs globally').retained()[0]();assert.equal(requests,n);release();await turn();s.m.unmount();});
test('Health recovers missing journal without local disconnect',async()=>{const o=owned();let drop=true;const p:ShellCorePort={...o.port,openEvents(g,r,e){return o.port.openEvents(g,(gen,b)=>drop?true:r(gen,b),e);}};const s=await setup(p);await connect(s);approve(o);s.m.setStartIntent(intent());s.d.button('Start selected run').click();await turn();o.owner.tick('A');s.d.button('Check health').click();await turn();assert.equal(s.m.snapshot().core.view.degraded,false);assert.equal(s.d.button('Start selected run').disabled,false);assert.equal(s.d.button('Reconnect explicitly').disabled,true);assert.equal(o.owner.inspectTransport().generation,1);drop=false;assert.match(s.host.textContent,/A: running/);s.m.unmount();});
test('stale transport events after reconnect cannot repaint DOM',async()=>{const o=owned();let receive!:(g:number,b:Uint8Array)=>boolean,end!:()=>void;const p:ShellCorePort={...o.port,async openEvents(g,r,e){receive=r;end=e;return o.port.openEvents(g,r,e);}};const s=await setup(p);await connect(s);const stale=receive,oldEnd=end;s.d.button('Disconnect locally').click();await turn();await connect(s);const before=s.host.textContent,writes=s.d.totalWrites();assert.equal(stale(1,new TextEncoder().encode('{}')),false);oldEnd();await turn();assert.equal(s.host.textContent,before);assert.equal(s.d.totalWrites(),writes);s.m.unmount();});
test('pending Disconnect stays actionable and late command cannot repaint success',async()=>{const o=owned();let hold=false,release!:()=>void;const gate=new Promise<void>(r=>release=r);const p:ShellCorePort={...o.port,async request(...args){const r=await o.port.request(...args);if(hold)await gate;return r;}};const s=await setup(p);await connect(s);hold=true;s.d.button('Check health').click();await turn();assert.equal(s.d.button('Disconnect locally').disabled,false);s.d.button('Disconnect locally').click();await turn();assert.equal(s.m.snapshot().core.connected,false);release();await turn();assert.equal(s.m.snapshot().lastCommand,null);assert.equal(o.owner.inspectState().epoch,1);s.m.unmount();});
test('throwing cancel input getter shuts down controller transport rather than only its view',async()=>{const o=owned(),s=await setup(o.port);await connect(s);const input=s.d.elements.find(x=>x.tagName==='input')!;input.hook=op=>{if(op==='read-value')throw Error('getter');};for(const f of input.listeners.get('change')??[])f();await turn();assert.equal(s.m.snapshot().mounted,false);assert.equal(o.owner.inspectTransport().deliveryActive,false);});
test('streaming events preserve cancellation text while user edits it',async()=>{const o=owned(),s=await setup(o.port);await connect(s);approve(o);s.m.setStartIntent(intent());s.d.button('Start selected run').click();await turn();const input=s.d.elements.find(x=>x.tagName==='input')!;input.value='A';o.owner.tick('A');await turn();assert.equal(input.value,'A');s.m.unmount();});
test('editing a committed cancellation target invalidates it before blur or retained click',async()=>{const o=owned(),s=await setup(o.port);await connect(s);approve(o);s.m.setStartIntent(intent());s.d.button('Start selected run').click();await turn();s.m.selectCancelRun('A');const input=s.d.elements.find(x=>x.tagName==='input')!,cancel=s.d.button('Cancel selected run').retained()[0];input.value='B';for(const f of input.listeners.get('input')??[])f();o.owner.tick('A');await turn();assert.equal(input.value,'B');assert.equal(s.d.button('Cancel selected run').disabled,true);cancel();await turn();assert.equal(o.owner.inspectState().runs[0].state,'running');assert.match(s.host.textContent,/Cancel selection: none/);s.m.unmount();});
test('Enter in owned cancellation input prevents host form implicit submission only there',async()=>{const s=await setup(),input=s.d.elements.find(x=>x.tagName==='input')!;const listeners=[...input.listeners.get('keydown')??[]] as unknown as Array<(e:KeyboardEvent)=>void>;assert.equal(listeners.length,1);let prevented=0;listeners[0]({key:'Enter',preventDefault(){prevented++;}} as unknown as KeyboardEvent);assert.equal(prevented,1);listeners[0]({key:'x',preventDefault(){prevented++;}} as unknown as KeyboardEvent);assert.equal(prevented,1);s.m.unmount();listeners[0]({key:'Enter',preventDefault(){prevented++;}} as unknown as KeyboardEvent);assert.equal(prevented,1);});

test('owned key getter and preventDefault hooks cannot reenter command or disconnect',async()=>{const o=owned(),s=await setup(o.port);await connect(s);const input=s.d.elements.find(x=>x.tagName==='input')!,key=[...input.listeners.get('keydown')!][0] as unknown as (e:KeyboardEvent)=>void,stop=s.d.button('Stop all runs globally').retained()[0],disconnect=s.d.button('Disconnect locally').retained()[0];key({get key(){stop();disconnect();return 'Enter';},preventDefault(){stop();disconnect();}} as unknown as KeyboardEvent);await turn();assert.equal(o.owner.inspectState().epoch,1);assert.equal(s.m.snapshot().core.connected,true);s.m.unmount();});
